# Copy this file to .env and adjust the values if needed:  cp .env.example .env
# The .env file is never committed.

# PostgreSQL
POSTGRES_USER=quitt
POSTGRES_PASSWORD=quitt
POSTGRES_DB=quitt

# Backend
APP_NAME=quitt API
APP_ENV=development

# JWT
JWT_SECRET=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
